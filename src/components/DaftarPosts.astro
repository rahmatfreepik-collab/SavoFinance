---
// src/components/DaftarPosts.astro
import { supabase } from '../lib/supabase';

// Mengambil data dari tabel posts
const { data: posts } = await supabase
  .from('posts')
  .select('*')
  .order('created_at', { ascending: false });
---

<h2 class="text-xl font-bold mb-4 text-blue-950">Postingan Live Terkini ({posts ? posts.length : 0})</h2>

{posts && posts.length === 0 && <p class="text-gray-500 text-sm italic">Belum ada post yang dibuat.</p>}

<div class="space-y-4">
  {posts && posts.map((post) => (
    <div class="border-b border-gray-100 pb-4 last:border-0 last:pb-0">
      <h3 class="font-semibold text-lg text-gray-800">{post.title}</h3>
      <p class="text-gray-600 text-sm mt-1">{post.content}</p>
    </div>
  ))}
</div>