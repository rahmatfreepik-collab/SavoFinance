---
// src/components/Button.astro

// Definisikan tipe data untuk props (opsional tapi disarankan)
interface Props {
  text: string;
  variant?: 'primary' | 'secondary';
  type?: 'button' | 'submit' | 'reset';
}

const { text, variant = 'primary', type = 'button' } = Astro.props;

// Pengaturan gaya berdasarkan varian
const baseStyles = "px-6 py-2 rounded-lg font-medium transition-all duration-200 shadow-sm";
const variants = {
  primary: "bg-blue-900 text-white hover:bg-blue-800",
  secondary: "bg-gray-200 text-gray-800 hover:bg-gray-300"
};
---

<button type={type} class={`${baseStyles} ${variants[variant]}`}>
  {text}
</button>