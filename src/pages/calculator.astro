---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Pro Financial Calculator - SavoFinance" isDark={false}>
  <div class="min-h-screen bg-slate-50 pt-32 pb-24 font-sans selection:bg-blue-200">
    <div class="max-w-6xl mx-auto px-6">
      
      {/* HEADER SECTION */}
      <div class="text-center mb-16 relative z-10">
        <div class="inline-block bg-blue-100 text-blue-800 text-xs font-black tracking-widest uppercase px-4 py-1.5 rounded-full mb-4 shadow-sm border border-blue-200">
          SavoFinance Tools
        </div>
        <h1 class="text-4xl md:text-5xl font-black text-slate-900 tracking-tight mb-4 leading-tight">
          Financial <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-indigo-600">Control Room</span>
        </h1>
        <p class="text-slate-500 text-base md:text-lg max-w-2xl mx-auto font-medium">
          Calculate investment projections, business margins, and revenue estimates with precision and instant visualization.
        </p>
      </div>

      {/* CALCULATOR LAYOUT */}
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start relative">
        
        {/* SIDEBAR NAVIGATION */}
        <aside class="lg:col-span-4 bg-white/70 backdrop-blur-xl border border-slate-200/60 p-3 rounded-[2rem] shadow-[0_8px_30px_rgb(0,0,0,0.04)] flex flex-col gap-2 z-20 sticky top-32">
          
          <button data-calc="compound" class="calc-btn w-full text-left px-5 py-4 rounded-2xl transition-all duration-300 flex items-center gap-4 bg-gradient-to-r from-blue-600 to-indigo-600 text-white shadow-md shadow-blue-900/20 group">
            <div class="p-2 bg-white/20 rounded-lg group-hover:scale-110 transition-transform">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white" viewBox="0 0 20 20" fill="currentColor"><path d="M2 11a1 1 0 011-1h2a1 1 0 011 1v5a1 1 0 01-1 1H3a1 1 0 01-1-1v-5zM8 7a1 1 0 011-1h2a1 1 0 011 1v9a1 1 0 01-1 1H9a1 1 0 01-1-1V7zM14 4a1 1 0 011-1h2a1 1 0 011 1v12a1 1 0 01-1 1h-2a1 1 0 01-1-1V4z" /></svg>
            </div>
            <div>
              <span class="block text-sm font-extrabold tracking-wide">Compound Interest</span>
              <span class="text-[11px] text-blue-100 font-medium">Wealth growth projection</span>
            </div>
          </button>

          <button data-calc="margin" class="calc-btn w-full text-left px-5 py-4 rounded-2xl transition-all duration-300 flex items-center gap-4 text-slate-600 hover:bg-slate-100 group">
            <div class="p-2 bg-slate-200 rounded-lg group-hover:scale-110 transition-transform text-slate-500 group-hover:text-indigo-600 group-hover:bg-indigo-100">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M4 4a2 2 0 00-2 2v4a2 2 0 002 2V6h10a2 2 0 00-2-2H4zm2 6a2 2 0 012-2h8a2 2 0 012 2v4a2 2 0 01-2 2H8a2 2 0 01-2-2v-4zm6 4a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" /></svg>
            </div>
            <div>
              <span class="block text-sm font-extrabold tracking-wide">Margin & Pricing</span>
              <span class="text-[11px] text-slate-400 font-medium">Physical/digital pricing strategy</span>
            </div>
          </button>

          <button data-calc="affiliate" class="calc-btn w-full text-left px-5 py-4 rounded-2xl transition-all duration-300 flex items-center gap-4 text-slate-600 hover:bg-slate-100 group">
            <div class="p-2 bg-slate-200 rounded-lg group-hover:scale-110 transition-transform text-slate-500 group-hover:text-rose-600 group-hover:bg-rose-100">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M12.586 4.586a2 2 0 112.828 2.828l-3 3a2 2 0 01-2.828 0 1 1 0 00-1.414 1.414 4 4 0 005.656 0l3-3a4 4 0 00-5.656-5.656l-1.5 1.5a1 1 0 101.414 1.414l1.5-1.5zm-5 5a2 2 0 012.828 0 1 1 0 101.414-1.414 4 4 0 00-5.656 0l-3 3a4 4 0 105.656 5.656l1.5-1.5a1 1 0 10-1.414-1.414l-1.5 1.5a2 2 0 11-2.828-2.828l3-3z" clip-rule="evenodd" /></svg>
            </div>
            <div>
              <span class="block text-sm font-extrabold tracking-wide">Affiliate Commission</span>
              <span class="text-[11px] text-slate-400 font-medium">Creator conversion estimation</span>
            </div>
          </button>
          
        </aside>

        {/* MAIN DISPLAY AREA */}
        <main class="lg:col-span-8 bg-white border border-slate-200/60 p-8 md:p-10 rounded-[2.5rem] shadow-xl shadow-slate-200/50 min-h-[500px] flex flex-col justify-between relative overflow-hidden z-20">
          
          {/* Background Decoration */}
          <div class="absolute -top-32 -right-32 w-96 h-96 bg-blue-50 rounded-full blur-3xl opacity-60 pointer-events-none"></div>

          {/* 1. COMPOUND INTEREST PANEL */}
          <div id="panel-compound" class="calc-panel flex flex-col h-full animate-fade-in">
            <div>
              <h2 class="text-2xl font-black text-slate-900 mb-2">Compound Interest Simulator</h2>
              <p class="text-sm text-slate-500 mb-8 font-medium">See how the magic of compound interest multiplies your initial capital over time.</p>
              
              <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                <div class="flex flex-col gap-2">
                  <label for="ci-principal" class="text-xs font-bold text-slate-700 uppercase tracking-wider">Initial Principal ($)</label>
                  <input type="number" id="ci-principal" value="10000" class="w-full bg-slate-50 border-2 border-slate-100 text-slate-900 text-sm font-bold rounded-xl focus:border-blue-500 focus:ring-0 p-3.5 transition-colors" />
                </div>
                <div class="flex flex-col gap-2">
                  <label for="ci-rate" class="text-xs font-bold text-slate-700 uppercase tracking-wider">Annual Return (%)</label>
                  <input type="number" id="ci-rate" value="10" class="w-full bg-slate-50 border-2 border-slate-100 text-slate-900 text-sm font-bold rounded-xl focus:border-blue-500 focus:ring-0 p-3.5 transition-colors" />
                </div>
                <div class="flex flex-col gap-2">
                  <label for="ci-years" class="text-xs font-bold text-slate-700 uppercase tracking-wider">Duration (Years)</label>
                  <input type="number" id="ci-years" value="5" class="w-full bg-slate-50 border-2 border-slate-100 text-slate-900 text-sm font-bold rounded-xl focus:border-blue-500 focus:ring-0 p-3.5 transition-colors" />
                </div>
              </div>
            </div>

            <div class="mt-auto">
              <div class="bg-slate-950 rounded-2xl p-6 text-white relative overflow-hidden">
                <div class="z-10 relative flex flex-col md:flex-row justify-between items-end gap-6">
                  <div>
                    <span class="text-blue-400 text-xs font-bold tracking-widest uppercase block mb-1">Total Future Value</span>
                    <span id="result-ci-total" class="text-3xl md:text-4xl font-black tracking-tight">$0</span>
                  </div>
                  <div class="text-right">
                    <span class="text-slate-400 text-xs font-medium block mb-1">Net Profit (Interest)</span>
                    <span id="result-ci-profit" class="text-emerald-400 font-bold text-lg">+$0</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          {/* 2. PROFIT MARGIN PANEL */}
          <div id="panel-margin" class="calc-panel hidden flex flex-col h-full animate-fade-in">
            <div>
              <h2 class="text-2xl font-black text-slate-900 mb-2">Pricing & Profit Margin</h2>
              <p class="text-sm text-slate-500 mb-8 font-medium">Determine the ideal selling price for your physical, digital, or F&B products based on your target profit margin.</p>
              
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                <div class="flex flex-col gap-2">
                  <label for="pm-cost" class="text-xs font-bold text-slate-700 uppercase tracking-wider">Total Cost ($)</label>
                  <input type="number" id="pm-cost" value="25" class="w-full bg-slate-50 border-2 border-slate-100 text-slate-900 text-sm font-bold rounded-xl focus:border-indigo-500 focus:ring-0 p-3.5 transition-colors" />
                </div>
                <div class="flex flex-col gap-2">
                  <label for="pm-margin-slider" class="text-xs font-bold text-slate-700 uppercase tracking-wider">Target Profit Margin (%)</label>
                  <div class="flex items-center gap-4">
                     <input type="range" id="pm-margin-slider" min="5" max="95" value="40" class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-indigo-600" />
                     <span id="pm-margin-display" class="bg-indigo-100 text-indigo-700 font-bold px-3 py-1.5 rounded-lg text-sm w-16 text-center">40%</span>
                  </div>
                </div>
              </div>
            </div>

            <div class="mt-auto">
              <div class="bg-indigo-50 border border-indigo-100 rounded-2xl p-6 relative overflow-hidden">
                <div class="flex flex-col md:flex-row justify-between items-center gap-6 mb-4">
                  <div class="w-full md:w-1/2">
                    <span class="text-indigo-800 text-xs font-bold tracking-widest uppercase block mb-1">Recommended Selling Price</span>
                    <span id="result-pm-price" class="text-3xl md:text-4xl font-black text-slate-900 tracking-tight">$0</span>
                  </div>
                  <div class="w-full md:w-1/2 bg-white rounded-xl p-4 shadow-sm border border-indigo-50/50">
                    <span class="text-slate-500 text-xs font-bold uppercase block mb-1">Profit Per Item</span>
                    <span id="result-pm-profit" class="text-emerald-600 font-black text-xl">$0</span>
                  </div>
                </div>
                {/* Visual Bar */}
                <div class="w-full h-2 bg-white rounded-full overflow-hidden flex">
                   <div id="bar-cost" class="h-full bg-slate-300 transition-all duration-500" style="width: 60%"></div>
                   <div id="bar-profit" class="h-full bg-indigo-500 transition-all duration-500" style="width: 40%"></div>
                </div>
                <div class="flex justify-between text-[10px] text-slate-400 mt-1 font-bold uppercase">
                  <span>Cost</span>
                  <span>Profit Margin</span>
                </div>
              </div>
            </div>
          </div>

          {/* 3. AFFILIATE COMMISSION PANEL */}
          <div id="panel-affiliate" class="calc-panel hidden flex flex-col h-full animate-fade-in">
            <div>
              <h2 class="text-2xl font-black text-slate-900 mb-2">Creator Affiliate Estimator</h2>
              <p class="text-sm text-slate-500 mb-8 font-medium">Calculate potential revenue from digital marketing campaigns or creator affiliate links.</p>
              
              <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                <div class="flex flex-col gap-2">
                  <label for="af-views" class="text-xs font-bold text-slate-700 uppercase tracking-wider">Views / Traffic</label>
                  <input type="number" id="af-views" value="10000" class="w-full bg-slate-50 border-2 border-slate-100 text-slate-900 text-sm font-bold rounded-xl focus:border-rose-500 focus:ring-0 p-3.5 transition-colors" />
                </div>
                <div class="flex flex-col gap-2">
                  <label for="af-conversion" class="text-xs font-bold text-slate-700 uppercase tracking-wider">Conversion Rate (%)</label>
                  <input type="number" id="af-conversion" value="1.5" step="0.1" class="w-full bg-slate-50 border-2 border-slate-100 text-slate-900 text-sm font-bold rounded-xl focus:border-rose-500 focus:ring-0 p-3.5 transition-colors" />
                </div>
                <div class="flex flex-col gap-2">
                  <label for="af-commission" class="text-xs font-bold text-slate-700 uppercase tracking-wider">Commission per Sale ($)</label>
                  <input type="number" id="af-commission" value="15" class="w-full bg-slate-50 border-2 border-slate-100 text-slate-900 text-sm font-bold rounded-xl focus:border-rose-500 focus:ring-0 p-3.5 transition-colors" />
                </div>
              </div>
            </div>

            <div class="mt-auto">
              <div class="bg-rose-50 border border-rose-100 rounded-2xl p-6">
                <div class="flex flex-col md:flex-row justify-between items-center">
                   <div>
                    <span class="text-rose-800 text-xs font-bold tracking-widest uppercase block mb-1">Estimated Total Revenue</span>
                    <span id="result-af-total" class="text-3xl md:text-4xl font-black text-slate-900 tracking-tight">$0</span>
                  </div>
                  <div class="text-right mt-4 md:mt-0 bg-white px-5 py-3 rounded-xl shadow-sm">
                    <span class="text-slate-400 text-xs font-bold uppercase block">Estimated Sales</span>
                    <span id="result-af-sales" class="text-rose-600 font-black text-lg">0 Items</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </main>
      </div>
    </div>
  </div>

  <style>
    .animate-fade-in {
      animation: fadeIn 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>
</Layout>

<script is:inline>
  // --- UI NAVIGATION LOGIC ---
  const buttons = document.querySelectorAll('.calc-btn');
  const panels = document.querySelectorAll('.calc-panel');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-calc');

      // Reset Styles
      buttons.forEach(b => {
        b.className = "calc-btn w-full text-left px-5 py-4 rounded-2xl transition-all duration-300 flex items-center gap-4 text-slate-600 hover:bg-slate-100 group";
        b.querySelector('div').className = "p-2 bg-slate-200 rounded-lg group-hover:scale-110 transition-transform text-slate-500 group-hover:text-blue-600 group-hover:bg-blue-100";
        b.querySelector('span:first-of-type').classList.replace('text-white', 'text-slate-900');
        b.querySelector('span:last-of-type').classList.replace('text-blue-100', 'text-slate-400');
      });

      // Active Styles (Match colors based on target)
      let activeBg = "bg-gradient-to-r from-blue-600 to-indigo-600 shadow-md shadow-blue-900/20 text-white";
      let activeIconBg = "bg-white/20 text-white";
      
      if (targetId === 'margin') activeBg = "bg-gradient-to-r from-indigo-600 to-violet-600 shadow-md shadow-indigo-900/20 text-white";
      if (targetId === 'affiliate') activeBg = "bg-gradient-to-r from-rose-500 to-pink-600 shadow-md shadow-rose-900/20 text-white";

      btn.className = `calc-btn w-full text-left px-5 py-4 rounded-2xl transition-all duration-300 flex items-center gap-4 group ${activeBg}`;
      btn.querySelector('div').className = `p-2 rounded-lg group-hover:scale-110 transition-transform ${activeIconBg}`;
      
      // Toggle Panels
      panels.forEach(p => {
        if (p.id === `panel-${targetId}`) p.classList.remove('hidden');
        else p.classList.add('hidden');
      });
    });
  });

  // --- FORMATTER ---
  function formatUSD(num) {
    return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(num);
  }

  // --- 1. COMPOUND INTEREST LOGIC ---
  function calcCompound() {
    const p = parseFloat(document.getElementById('ci-principal').value) || 0;
    const r = parseFloat(document.getElementById('ci-rate').value) || 0;
    const t = parseFloat(document.getElementById('ci-years').value) || 0;
    
    const finalAmount = p * Math.pow((1 + (r / 100)), t);
    const profit = finalAmount - p;

    document.getElementById('result-ci-total').innerText = formatUSD(finalAmount);
    document.getElementById('result-ci-profit').innerText = `+ ${formatUSD(profit)}`;
  }
  ['ci-principal', 'ci-rate', 'ci-years'].forEach(id => document.getElementById(id).addEventListener('input', calcCompound));

  // --- 2. PROFIT MARGIN LOGIC ---
  function calcMargin() {
    const cost = parseFloat(document.getElementById('pm-cost').value) || 0;
    const margin = parseFloat(document.getElementById('pm-margin-slider').value) || 0;
    
    document.getElementById('pm-margin-display').innerText = `${margin}%`;

    // Selling Price = Cost / (1 - (Margin / 100))
    const price = cost / (1 - (margin / 100));
    const profit = price - cost;

    document.getElementById('result-pm-price').innerText = formatUSD(price);
    document.getElementById('result-pm-profit').innerText = formatUSD(profit);

    // Update Visual Bar
    const costPct = price > 0 ? (cost / price) * 100 : 0;
    const profitPct = price > 0 ? 100 - costPct : 0;
    document.getElementById('bar-cost').style.width = `${costPct}%`;
    document.getElementById('bar-profit').style.width = `${profitPct}%`;
  }
  ['pm-cost', 'pm-margin-slider'].forEach(id => document.getElementById(id).addEventListener('input', calcMargin));

  // --- 3. AFFILIATE LOGIC ---
  function calcAffiliate() {
    const views = parseFloat(document.getElementById('af-views').value) || 0;
    const convRate = parseFloat(document.getElementById('af-conversion').value) || 0;
    const commPerSale = parseFloat(document.getElementById('af-commission').value) || 0;

    const totalSales = Math.floor(views * (convRate / 100));
    const totalRevenue = totalSales * commPerSale;

    document.getElementById('result-af-sales').innerText = `${totalSales.toLocaleString('en-US')} Items`;
    document.getElementById('result-af-total').innerText = formatUSD(totalRevenue);
  }
  ['af-views', 'af-conversion', 'af-commission'].forEach(id => document.getElementById(id).addEventListener('input', calcAffiliate));

  // Initial Calculation
  calcCompound();
  calcMargin();
  calcAffiliate();
</script>