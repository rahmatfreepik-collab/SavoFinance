// src/pages/admin.astro
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

const url = new URL(Astro.request.url);
const statusSukses = url.searchParams.get('sukses');
const statusError = url.searchParams.get('error');

let pesanSukses = statusSukses ? 'Data berhasil diperbarui atau diterbitkan!' : '';
let pesanError = statusError || '';

// Ambil data dari KEDUA tabel (posts dan news)
let posts = [];
let newsList = [];

try {
  const { data: postsData } = await supabase
    .from('posts')
    .select('id, title, category, created_at, content')
    .order('created_at', { ascending: false })
    .limit(10);
    
  if (postsData) posts = postsData;

  const { data: newsData } = await supabase
    .from('news')
    .select('id, title, source, created_at, content')
    .order('created_at', { ascending: false })
    .limit(10);
    
  if (newsData) newsList = newsData;
} catch (e) {
  console.error("Gagal mengambil data database:", e);
}

let tujuanRedirect = '';

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const postId = formData.get('postId')?.toString(); 
    const contentType = formData.get('contentType')?.toString();
    const title = formData.get('title')?.toString().trim();
    const content = formData.get('content')?.toString().trim();

    if (title && content && content !== '<p><br></p>') {
      
      const imageFiles = formData.getAll('news_images'); 
      const uploadedUrls = [];

      for (const file of imageFiles) {
        if (file instanceof File && file.size > 0) {
          const fileExt = file.name.split('.').pop();
          const fileName = `${Date.now()}-${Math.random().toString(36).substring(2, 7)}.${fileExt}`;
          
          const { data: uploadData, error: uploadError } = await supabase.storage
            .from('news-images')
            .upload(fileName, file, {
              contentType: file.type,
              upsert: true
            });

          if (!uploadError && uploadData) {
            const { data: urlData } = supabase.storage
              .from('news-images')
              .getPublicUrl(fileName);
              
            if (urlData?.publicUrl) {
              uploadedUrls.push(urlData.publicUrl);
            }
          }
        }
      }

      // --- EKSEKUSI DATA (UPDATE ATAU INSERT) ---
      if (postId) {
        if (contentType === 'news') {
          const source = formData.get('source')?.toString().trim() || 'Internal';
          const updateData = { title, content, source };
          if (uploadedUrls.length > 0) updateData.images = uploadedUrls;

          const { error } = await supabase
            .from('news')
            .update(updateData)
            .eq('id', postId);

          tujuanRedirect = error 
            ? `/admin?error=${encodeURIComponent('Gagal update berita: ' + error.message)}`
            : '/admin?sukses=1';
        } else {
          const category = formData.get('category')?.toString().trim();
          if (!category) {
            tujuanRedirect = `/admin?error=${encodeURIComponent('Kategori artikel wajib diisi!')}`;
          } else {
            const updateData = { title, category, content };
            if (uploadedUrls.length > 0) updateData.images = uploadedUrls;

            const { error } = await supabase
              .from('posts')
              .update(updateData)
              .eq('id', postId);

            tujuanRedirect = error 
              ? `/admin?error=${encodeURIComponent('Gagal update artikel: ' + error.message)}`
              : '/admin?sukses=1';
          }
        }

      } else {
        if (contentType === 'news') {
          const source = formData.get('source')?.toString().trim() || 'Internal';
          const { error } = await supabase
            .from('news')
            .insert([{ title, content, source, images: uploadedUrls }]);

          tujuanRedirect = error ? `/admin?error=${encodeURIComponent(error.message)}` : '/terima-kasih';
        } else {
          const category = formData.get('category')?.toString().trim();
          if (!category) {
            tujuanRedirect = `/admin?error=${encodeURIComponent('Kategori artikel wajib diisi!')}`;
          } else {
            const { error } = await supabase
              .from('posts')
              .insert([{ title, category, content, images: uploadedUrls }]);

            tujuanRedirect = error ? `/admin?error=${encodeURIComponent(error.message)}` : '/terima-kasih';
          }
        }
      }

    } else {
      tujuanRedirect = `/admin?error=${encodeURIComponent('Mohon isi semua kolom!')}`;
    }
  } catch (e) {
    tujuanRedirect = `/admin?error=${encodeURIComponent('Terjadi gangguan sistem internal.')}`;
  }
}

if (tujuanRedirect) {
  return Astro.redirect(tujuanRedirect);
}
