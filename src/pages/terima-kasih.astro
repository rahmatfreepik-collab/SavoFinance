---
// src/pages/terima-kasih.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Postingan Berhasil!">
  <div class="max-w-md mx-auto mt-40 p-8 bg-white rounded-xl shadow-lg border border-gray-100 text-center flex flex-col items-center gap-4">
    <div class="w-16 h-16 bg-green-50 rounded-full flex items-center justify-center text-green-500 text-3xl shadow-inner">
      ✓
    </div>
    <h1 class="text-2xl font-bold text-blue-900">Terima Kasih!</h1>
    <p class="text-gray-500 text-sm leading-relaxed">
      Postingan analisis keuangan baru Anda telah berhasil disimpan dan diterbitkan langsung ke halaman utama.
    </p>
    <div class="flex gap-3 w-full mt-2">
      <a href="/admin" class="flex-1 bg-blue-900 text-white py-2.5 rounded-lg text-sm font-bold hover:bg-blue-800 transition shadow-sm">
        Tulis Lagi
      </a>
      <a href="/" class="flex-1 bg-gray-100 text-gray-700 py-2.5 rounded-lg text-sm font-semibold hover:bg-gray-200 transition">
        Lihat Website
      </a>
    </div>
  </div>
</Layout>