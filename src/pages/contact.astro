---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Us - SavoFinance" isDark={false}>
  <div class="w-screen -mx-24 flex flex-col bg-slate-50 min-h-screen pt-32 pb-20 px-6 md:px-24">
    
    <div class="max-w-3xl mx-auto w-full">
      <div class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl font-black text-slate-900 tracking-tight mb-4">Get in Touch</h1>
        <p class="text-slate-500 text-lg">Have a question or feedback? Send us a message and we'll get back to you shortly.</p>
      </div>

      <div class="bg-white rounded-3xl p-8 md:p-12 shadow-xl shadow-slate-200/50 border border-slate-200">
        <form id="formKontak" class="flex flex-col gap-6">
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="nama" class="block text-sm font-bold text-slate-700 mb-2">Name</label>
              <input type="text" id="nama" name="name" required placeholder="Your full name" class="w-full bg-slate-50 border border-slate-200 text-slate-900 text-base rounded-xl focus:ring-blue-500 focus:border-blue-500 block p-3.5 transition-colors" />
            </div>

            <div>
              <label for="email" class="block text-sm font-bold text-slate-700 mb-2">Email Address</label>
              <input type="email" id="email" name="email" required placeholder="you@example.com" class="w-full bg-slate-50 border border-slate-200 text-slate-900 text-base rounded-xl focus:ring-blue-500 focus:border-blue-500 block p-3.5 transition-colors" />
            </div>
          </div>

          <div>
            <label for="subjek" class="block text-sm font-bold text-slate-700 mb-2">Subject (Optional)</label>
            <input type="text" id="subjek" name="subject" placeholder="What is this regarding?" class="w-full bg-slate-50 border border-slate-200 text-slate-900 text-base rounded-xl focus:ring-blue-500 focus:border-blue-500 block p-3.5 transition-colors" />
          </div>

          <div>
            <label for="isi_pesan" class="block text-sm font-bold text-slate-700 mb-2">Message</label>
            <textarea id="isi_pesan" name="message" rows="5" required placeholder="Write your message here..." class="w-full bg-slate-50 border border-slate-200 text-slate-900 text-base rounded-xl focus:ring-blue-500 focus:border-blue-500 block p-3.5 transition-colors resize-y"></textarea>
          </div>

          <div class="mt-4 flex flex-col sm:flex-row items-center gap-4">
            <button type="submit" id="btnSubmit" class="w-full sm:w-auto px-8 py-4 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl transition-colors shadow-lg shadow-blue-600/30">
              Send Message
            </button>
            <span id="statusPesan" class="text-sm font-medium hidden"></span>
          </div>

        </form>
      </div>
    </div>

  </div>
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  function inisialisasiForm() {
    const formKontak = document.getElementById('formKontak') as HTMLFormElement;
    const btnSubmit = document.getElementById('btnSubmit') as HTMLButtonElement;
    const statusPesan = document.getElementById('statusPesan');

    if (!formKontak || !btnSubmit || !statusPesan) return;

    // Hapus event lama agar tidak menumpuk saat ganti halaman
    formKontak.removeEventListener('submit', submitHandler);
    formKontak.addEventListener('submit', submitHandler);

    async function submitHandler(e: Event) {
      e.preventDefault();
      
      const originalBtnText = btnSubmit.innerText;
      btnSubmit.innerText = 'Sending...';
      btnSubmit.disabled = true;
      statusPesan.className = 'text-sm font-medium text-slate-500';
      statusPesan.innerText = 'Memproses...';
      statusPesan.classList.remove('hidden');

      const formData = new FormData(e.target as HTMLFormElement);
      const dataPesan = {
        name: formData.get('name'),
        email: formData.get('email'),
        subject: formData.get('subject'),
        message: formData.get('message'),
      };

      try {
        const { error } = await supabase.from('contact_messages').insert([dataPesan]);
        if (error) throw error;

        statusPesan.className = 'text-sm font-bold text-emerald-600';
        statusPesan.innerText = '✓ Message sent successfully!';
        (e.target as HTMLFormElement).reset(); 
      } catch (error: any) {
        console.error("Detail Error:", error); 
        statusPesan.className = 'text-sm font-bold text-rose-500';
        statusPesan.innerText = '✕ Error: ' + error.message; 
      } finally {
        btnSubmit.innerText = originalBtnText;
        btnSubmit.disabled = false;
        setTimeout(() => {
          statusPesan.classList.add('hidden');
        }, 5000);
      }
    }
  }

  // Jalankan saat load pertama & setiap kali ganti halaman via Astro
  inisialisasiForm();
  document.addEventListener('astro:page-load', inisialisasiForm);
</script>