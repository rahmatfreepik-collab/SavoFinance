---
import '../styles/global.css';

// 1. Tambahkan properti isNewsDetail ke dalam Props
interface Props {
  title?: string;
  isDark?: boolean; // Jika true = tema gelap (Home), jika false = tema terang (News, dll)
  isNewsDetail?: boolean; // JIKA TRUE = Logo di tengah, menu sembunyi ke hamburger (News Detail)
}

const { title = "SavoFinance", isDark = false, isNewsDetail = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  {/* Warna latar belakang utama body berubah dinamis berdasarkan nilai properti isDark */}
  <body class={`min-h-screen flex flex-col justify-between antialiased overflow-x-hidden ${isDark ? 'bg-slate-950 text-slate-100' : 'bg-white text-slate-900'}`}>
    
    {/* NAVBAR UTAMA */}
    <header 
      id="main-navbar" 
      data-is-dark={isDark ? "true" : "false"}
      class={`fixed top-0 left-0 w-full z-50 transition-all duration-300 ${
        isDark 
          ? 'bg-slate-950 text-slate-100 border-b border-slate-900' 
          : 'bg-white text-slate-900 border-b border-gray-100 shadow-sm'
      }`}
    >
      {/* PADDING DIUBAH MENJADI RESPONSIF (px-4 pada HP, px-24 pada Laptop/Desktop) */}
      <div class="flex items-center justify-between px-4 md:px-24 py-5 transition-all duration-300 relative" id="navbar-container">
        
        {/* LOGO: Jika isNewsDetail aktif, otomatis pindah ke tengah absolut */}
        <a href="/" class={`flex items-center shrink-0 transition-all ${isNewsDetail ? 'absolute left-1/2 transform -translate-x-1/2 z-10' : ''}`}>
          <img src="/logo.png" alt="Logo" class="h-10 w-auto" />
        </a>

        {/* MENU UTAMA & TOMBOL SISI KANAN */}
        <div class={`flex items-center gap-4 md:gap-8 ${isNewsDetail ? 'ml-auto w-full justify-end' : ''}`}>
          
          {/* Menu Navigasi Teks Desktop (Disembunyikan jika di halaman detail berita atau di layar HP) */}
          <ul class={`items-center gap-6 font-medium text-inherit text-sm tracking-wider ${isNewsDetail ? 'hidden' : 'hidden md:flex'}`}>
            <li>
              <a href="/" class="hover:text-cyan-400 transition-colors">HOME</a>
            </li>
            
            <li class="relative inline-block text-left group py-2">
              <a 
                href="/education" 
                class="flex items-center gap-1 hover:text-cyan-400 transition-colors uppercase focus:outline-none cursor-pointer"
              >
                Education
                <svg class="w-4 h-4 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              </a>

              {/* Dropdown Menu Education */}
              <div 
                class={`hidden group-hover:block absolute left-0 mt-2 w-56 border rounded-xl shadow-xl py-2 z-50 transition-all ${
                  isDark 
                    ? 'bg-slate-900 border-slate-800 text-slate-200' 
                    : 'bg-white border-gray-200 text-slate-800'
                }`}
                id="dropdown-box"
              >
                <a href="/education/personal-finance" class="block px-4 py-2 text-xs hover:bg-slate-800 hover:text-cyan-400 dark:hover:bg-slate-100 transition font-bold">PERSONAL FINANCE</a>
                <a href="/education/investment" class="block px-4 py-2 text-xs hover:bg-slate-800 hover:text-cyan-400 dark:hover:bg-slate-100 transition font-bold">INVESTMENT</a>
                <a href="/education/crypto-basics" class="block px-4 py-2 text-xs hover:bg-slate-800 hover:text-cyan-400 dark:hover:bg-slate-100 transition font-bold">CRYPTO BASICS</a>
                <a href="/education/market-analysis" class="block px-4 py-2 text-xs hover:bg-slate-800 hover:text-cyan-400 dark:hover:bg-slate-100 transition font-bold">MARKET ANALYSIS</a>
              </div>
            </li>

            <li>
              <a href="/news" class="hover:text-cyan-400 transition-colors">NEWS</a>
            </li>

            <li>
              <a href="/calculator" class="hover:text-cyan-400 transition-colors">CALCULATOR</a>
            </li>
            
            <li>
              <a href="/about" class="hover:text-cyan-400 transition-colors">ABOUT</a>
            </li>
          </ul>
          
          {/* TOMBOL CARI (Tetap ada di sebelah kanan) */}
          <div class="relative inline-block text-left shrink-0 z-20">
            <button 
              id="trigger-search-btn" 
              class="p-2 text-inherit hover:text-cyan-400 transition-colors focus:outline-none flex items-center justify-center rounded-lg"
              aria-label="Toggle Search"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </button>

            {/* Kotak Dropdown Input Cari */}
            <div 
              id="search-dropdown-box" 
              class={`hidden absolute right-0 mt-3 w-80 border rounded-2xl p-4 shadow-2xl z-50 transition-all ${
                isDark 
                  ? 'bg-slate-950 border-slate-800' 
                  : 'bg-white border-gray-200'
              }`}
            >
              <div class="flex items-center gap-2 relative">
                <input 
                  type="text" 
                  id="navbar-search-input" 
                  placeholder="Search news & education..." 
                  class={`w-full pl-4 pr-10 py-2.5 border rounded-xl focus:outline-none text-sm placeholder-slate-500 transition-all ${
                    isDark 
                      ? 'bg-slate-900 border-slate-800 text-slate-100 focus:border-cyan-500' 
                      : 'bg-slate-100 border-gray-300 text-slate-900 focus:border-blue-500'
                  }`}
                />
                
                <button 
                  id="execute-search-btn" 
                  class="absolute right-2 p-1.5 text-slate-500 hover:text-cyan-400 transition-colors"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                  </svg>
                </button>
              </div>

              <div id="navbar-search-status" class="mt-2 text-xs font-semibold px-1 hidden"></div>
            </div>
          </div>

          {/* TOMBOL HAMBURGER (BARIS 3): Muncul otomatis di HP, atau selalu muncul di halaman detail berita */}
          <button 
            id="trigger-menu-btn" 
            class={`p-2 text-inherit hover:text-cyan-400 transition-colors focus:outline-none flex items-center justify-center rounded-lg z-20 ${isNewsDetail ? 'block' : 'block md:hidden'}`}
            aria-label="Toggle Menu"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>

          {/* PANEL NAVIGASI DROPDOWN BARIS 3 */}
          <div 
            id="mobile-menu-box" 
            class={`hidden absolute right-4 md:right-24 mt-16 w-56 border rounded-2xl p-4 shadow-2xl z-50 transition-all ${
              isDark 
                ? 'bg-slate-950 border-slate-800 text-slate-100' 
                : 'bg-white border-gray-200 text-slate-900'
            }`}
          >
            <ul class="flex flex-col gap-4 font-bold text-sm tracking-wider">
              <li><a href="/" class="hover:text-cyan-400 transition-colors block py-1">HOME</a></li>
              <li><a href="/education" class="hover:text-cyan-400 transition-colors block py-1">EDUCATION</a></li>
              <li><a href="/news" class="hover:text-cyan-400 transition-colors block py-1">NEWS</a></li>
              <li><a href="/calculator" class="hover:text-cyan-400 transition-colors block py-1">CALCULATOR</a></li>
              <li><a href="/about" class="hover:text-cyan-400 transition-colors block py-1">ABOUT</a></li>
            </ul>
          </div>

        </div>
      </div>
    </header>

    {/* CONTAINER CONTENT: Diubah juga ke px-4 agar konten tulisan di HP tidak tercekik */}
    <main class="pt-20 md:pt-28 px-4 md:px-24 flex-grow relative">
      <slot />
    </main>

    {/* FOOTER: Diubah ke px-4 agar responsive */}
    <footer class="bg-[#060B14] border-t border-slate-900 text-slate-300 font-sans z-10 relative">
      <div class="px-4 md:px-24 pt-16 pb-8 max-w-7xl mx-auto">
        
        {/* Top Section */}
        <div class="grid grid-cols-1 md:grid-cols-12 gap-12 mb-12">
          <div class="md:col-span-12 lg:col-span-6">
            <a href="/" class="inline-block mb-6 group">
              <span class="text-3xl font-black tracking-tight text-[#00D2FF] transition-transform group-hover:scale-105 inline-block">
                SavoFinance
              </span>
            </a>
            <p class="text-slate-400 leading-relaxed text-sm lg:pr-12">
              Your trusted provider of independent financial analysis, investment insights, and cutting-edge digital asset management strategies.
            </p>
          </div>

          <div class="md:col-span-6 lg:col-span-3">
            <h3 class="text-white font-bold uppercase tracking-wider text-xs mb-6">Navigation</h3>
            <ul class="flex flex-col gap-4">
              <li><a href="/" class="text-slate-400 hover:text-[#00D2FF] transition-colors text-sm font-medium">Home</a></li>
              <li><a href="/education" class="text-slate-400 hover:text-[#00D2FF] transition-colors text-sm font-medium">Education</a></li>
              <li><a href="/news" class="text-slate-400 hover:text-[#00D2FF] transition-colors text-sm font-medium">News</a></li>
              <li><a href="/calculator" class="text-slate-400 hover:text-[#00D2FF] transition-colors text-sm font-medium">Calculator</a></li>
            </ul>
          </div>

          <div class="md:col-span-6 lg:col-span-3">
            <h3 class="text-white font-bold uppercase tracking-wider text-xs mb-6">Legal & Support</h3>
            <ul class="flex flex-col gap-4">
              <li><a href="/privacy" class="text-slate-400 hover:text-[#00D2FF] transition-colors text-sm font-medium">Privacy Policy</a></li>
              <li><a href="/terms" class="text-slate-400 hover:text-[#00D2FF] transition-colors text-sm font-medium">Terms & Conditions</a></li>
              <li><a href="/contact" class="text-slate-400 hover:text-[#00D2FF] transition-colors text-sm font-medium">Contact Us</a></li>
            </ul>
          </div>
        </div>

        <div class="border-y border-slate-800/80 py-8 my-8">
          <p class="text-xs text-slate-500 leading-relaxed text-justify">
            <strong class="text-slate-300">Financial Disclaimer:</strong> All content, analysis, simulations, and educational materials presented on SavoFinance are provided purely for general informational and educational purposes only.
          </p>
        </div>

        <div class="text-center pt-2">
          <p class="text-xs text-slate-500 font-medium tracking-wide">
            &copy; 2026 SavoFinance. All rights reserved.
          </p>
        </div>
      </div>
    </footer>

    {/* JAVASCRIPT LOGIC */}
    <script>
      const navbar = document.getElementById('main-navbar');
      const container = document.getElementById('navbar-container');
      const dropdownBox = document.getElementById('search-dropdown-box');
      const dropdownBoxMenu = document.getElementById('dropdown-box');
      
      const triggerBtn = document.getElementById('trigger-search-btn');
      const searchInput = document.getElementById('navbar-search-input') as HTMLInputElement;
      const executeBtn = document.getElementById('execute-search-btn');
      const statusMessage = document.getElementById('navbar-search-status');

      // Deklarasi tombol Hamburger baru
      const triggerMenuBtn = document.getElementById('trigger-menu-btn');
      const mobileMenuBox = document.getElementById('mobile-menu-box');

      const isInitialDark = navbar?.getAttribute('data-is-dark') === 'true';

      let currentAvailableCount = 0;
      let typingTimer: NodeJS.Timeout;

      // ─── KONTROL INTERAKSI BARIS 3 (HAMBURGER) ───
      triggerMenuBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        mobileMenuBox?.classList.toggle('hidden');
        dropdownBox?.classList.add('hidden'); // Tutup pencarian jika menu dibuka
      });

      // ─── 1. KONTROL INTERAKSI DROP-DOWN CARI ───
      triggerBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        dropdownBox?.classList.toggle('hidden');
        mobileMenuBox?.classList.add('hidden'); // Tutup hamburger jika cari dibuka
        if (!dropdownBox?.classList.contains('hidden')) {
          searchInput?.focus();
        }
      });

      document.addEventListener('click', (e) => {
        if (!dropdownBox?.contains(e.target as Node) && !triggerBtn?.contains(e.target as Node)) {
          dropdownBox?.classList.add('hidden');
        }
        if (!mobileMenuBox?.contains(e.target as Node) && !triggerMenuBtn?.contains(e.target as Node)) {
          mobileMenuBox?.classList.add('hidden');
        }
      });

      // ─── 2. LIVE HITUNG DATABASE (DEBOUNCE) ───
      async function checkLiveCount() {
        const query = searchInput?.value.trim();
        
        if (!query) {
          currentAvailableCount = 0;
          if (statusMessage) statusMessage.classList.add('hidden');
          return;
        }

        if (statusMessage) {
          statusMessage.textContent = "Checking database...";
          statusMessage.className = "mt-2 text-xs font-semibold px-1 text-cyan-400 animate-pulse block";
        }

        try {
          const res = await fetch(`/api/check-search.json?q=${encodeURIComponent(query)}`);
          const data = await res.json();
          
          currentAvailableCount = data.count || 0;

          if (currentAvailableCount > 0) {
            if (statusMessage) {
              statusMessage.textContent = `🟢 ${currentAvailableCount} ${currentAvailableCount === 1 ? 'page' : 'pages'} available. Press Enter.`;
              statusMessage.className = "mt-2 text-xs font-semibold px-1 text-emerald-400 block";
            }
          } else {
            if (statusMessage) {
              statusMessage.textContent = `🔴 No pages found for "${query}".`;
              statusMessage.className = "mt-2 text-xs font-semibold px-1 text-rose-400 block";
            }
          }
        } catch (err) {
          if (statusMessage) {
            statusMessage.textContent = "Connection error.";
            statusMessage.className = "mt-2 text-xs font-semibold px-1 text-amber-500 block";
          }
        }
      }

      searchInput?.addEventListener('input', () => {
        clearTimeout(typingTimer);
        
        const query = searchInput.value.trim();
        if (!query) {
          currentAvailableCount = 0;
          if (statusMessage) statusMessage.classList.add('hidden');
          return;
        }

        if (statusMessage) {
          statusMessage.textContent = "Typing...";
          statusMessage.className = "mt-2 text-xs font-medium px-1 text-slate-500 block";
        }

        typingTimer = setTimeout(checkLiveCount, 500);
      });

      // ─── 3. EKSEKUSI JIKA DATA TERSEDIA ───
      function navigateToSearchResults() {
        const query = searchInput?.value.trim();
        if (query && currentAvailableCount > 0) {
          if (statusMessage) statusMessage.classList.add('hidden');
          dropdownBox?.classList.add('hidden');
          window.location.href = `/search?q=${encodeURIComponent(query)}`;
        }
      }

      executeBtn?.addEventListener('click', navigateToSearchResults);
      searchInput?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          navigateToSearchResults();
        }
      });

      // ─── 4. LOGIKA SCROLL NAVBAR ADAPTIF ───
      window.addEventListener('scroll', () => {
        if (window.scrollY > 80) {
          if (navbar) {
            navbar.classList.remove('bg-slate-950', 'text-slate-100', 'border-slate-900');
            navbar.classList.add('bg-white/70', 'backdrop-blur-md', 'text-slate-900', 'border-gray-200/80', 'shadow-sm');
          }
          if (container) {
            container.classList.remove('py-5');
            container.classList.add('py-3.5');
          }
          if (searchInput) {
            searchInput.classList.remove('bg-slate-900', 'border-slate-800', 'text-slate-100', 'focus:border-cyan-500');
            searchInput.classList.add('bg-slate-100', 'border-gray-300', 'text-slate-900', 'focus:border-blue-500');
          }
          if (dropdownBox) {
            dropdownBox.classList.remove('bg-slate-950', 'border-slate-800');
            dropdownBox.classList.add('bg-white', 'border-gray-200');
          }
          if (dropdownBoxMenu) {
            dropdownBoxMenu.classList.remove('bg-slate-900', 'border-slate-800', 'text-slate-200');
            dropdownBoxMenu.classList.add('bg-white', 'border-gray-200', 'text-slate-800');
          }
          if (mobileMenuBox) {
            mobileMenuBox.classList.remove('bg-slate-950', 'border-slate-800', 'text-slate-100');
            mobileMenuBox.classList.add('bg-white', 'border-gray-200', 'text-slate-900');
          }
        } else {
          if (isInitialDark) {
            if (navbar) {
              navbar.classList.add('bg-slate-950', 'text-slate-100', 'border-slate-900');
              navbar.classList.remove('bg-white/70', 'backdrop-blur-md', 'text-slate-900', 'border-gray-200/80', 'shadow-sm');
            }
            if (searchInput) {
              searchInput.classList.add('bg-slate-900', 'border-slate-800', 'text-slate-100', 'focus:border-cyan-500');
              searchInput.classList.remove('bg-slate-100', 'border-gray-300', 'text-slate-900', 'focus:border-blue-500');
            }
            if (dropdownBox) {
              dropdownBox.classList.add('bg-slate-950', 'border-slate-800');
              dropdownBox.classList.remove('bg-white', 'border-gray-200');
            }
            if (dropdownBoxMenu) {
              dropdownBoxMenu.classList.add('bg-slate-900', 'border-slate-800', 'text-slate-200');
              dropdownBoxMenu.classList.remove('bg-white', 'border-gray-200', 'text-slate-800');
            }
            if (mobileMenuBox) {
              mobileMenuBox.classList.add('bg-slate-950', 'border-slate-800', 'text-slate-100');
              mobileMenuBox.classList.remove('bg-white', 'border-gray-200', 'text-slate-900');
            }
          } else {
            if (navbar) {
              navbar.classList.remove('bg-slate-950', 'text-slate-100', 'border-slate-900');
              navbar.classList.add('bg-white', 'text-slate-900', 'border-b', 'border-gray-100');
            }
          }
          
          if (container) {
            container.classList.remove('py-3.5');
            container.classList.add('py-5');
          }
        }
      });
    </script>
  </body>
</html>